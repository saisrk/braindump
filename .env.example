# =============================================================================
# Braindump - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# =============================================================================
# Database (Drizzle ORM)
# =============================================================================
# PostgreSQL connection string used by Drizzle ORM for all data access.
#
# Local development (using Docker Compose):
#   postgresql://postgres:postgres@localhost:5432/braindump
#
# Production:
#   Your PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/braindump

# =============================================================================
# Authentication (NextAuth.js / Auth.js)
# =============================================================================
# Secret used to encrypt tokens and cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Base URL of your application (used by NextAuth for callbacks)
# Local development: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000

# =============================================================================
# Google OAuth
# =============================================================================
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Anthropic AI
# =============================================================================
# API key for all AI features (summarization, review generation, teach-back grading).
# Used directly — no Vercel AI Gateway required.
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# Email (Resend)
# =============================================================================
# API key for sending transactional emails via Resend (https://resend.com).
# Used for OTP sign-in codes and the daily review digest cron job.
RESEND_API_KEY=re_your_api_key_here

# Sender address for OTP emails (must be a verified domain in Resend)
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Cron Job Security
# =============================================================================
# Random secret that protects the /api/cron/* endpoints from unauthorised calls.
# Set the same value as the "Authorization: Bearer <value>" header in Vercel Cron settings.
# Generate one with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# =============================================================================
# App URL (used in email links)
# =============================================================================
# Public URL of the app, used to generate links in digest emails.
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Stripe (Billing)
# =============================================================================
# Secret key from Stripe Dashboard → Developers → API keys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook signing secret — get this from Stripe Dashboard → Webhooks
# or from `stripe listen --print-secret` during local development
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Price IDs — create two products in Stripe Dashboard:
#   Product 1: Braindump Pro Monthly  → $12.00/month recurring
#   Product 2: Braindump Pro Annual   → $96.00/year recurring
# Then copy the Price IDs (price_...) here
STRIPE_MONTHLY_PRICE_ID=price_monthly_price_id_here
STRIPE_ANNUAL_PRICE_ID=price_annual_price_id_here
