# =============================================================================
# Braindump - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# =============================================================================
# Database (Drizzle ORM)
# =============================================================================
# PostgreSQL connection string used by Drizzle ORM for all data access.
#
# Local development (using Docker Compose):
#   postgresql://postgres:postgres@localhost:5432/braindump
#
# Production:
#   Your PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/braindump

# =============================================================================
# Authentication (NextAuth.js / Auth.js)
# =============================================================================
# Secret used to encrypt tokens and cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Base URL of your application (used by NextAuth for callbacks)
# Local development: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=http://localhost:3000

# =============================================================================
# Google OAuth
# =============================================================================
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Email (Resend)
# =============================================================================
# API key for sending transactional emails via Resend (https://resend.com).
# Used for OTP sign-in codes and the daily review digest cron job.
RESEND_API_KEY=re_your_api_key_here

# Sender address for OTP emails (must be a verified domain in Resend)
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# Cron Job Security
# =============================================================================
# Random secret that protects the /api/cron/* endpoints from unauthorised calls.
# Set the same value as the "Authorization: Bearer <value>" header in Vercel Cron settings.
# Generate one with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# =============================================================================
# App URL (used in email links)
# =============================================================================
# Public URL of the app, used to generate links in digest emails.
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
